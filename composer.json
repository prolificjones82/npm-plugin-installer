{
    "name": "prolificjones/npm-plugin-installer",
    "description": "Installs npm packages and patches package.json after composer install/update.",
    "type": "composer-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "LeeJones\\NpmInstaller\\": "src/"
        }
    },
    "extra": {
        "class": "LeeJones\\NpmInstaller\\Plugin"
    }
}
